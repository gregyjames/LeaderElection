<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Note: While we can target multiple TFMs here, e.g., net8.0;net10.0, we're
      targeting the SDK TFM for simplicity. Targeting multiple complicates the CI/CD
      pipeline due to multiple test frameworks needing to be installed. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Disable warnings globally in ./tests/.editorconfig -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Coverlet.MTP integration (Microsoft.Testing.Platform extension). Options are passed
    to the test application as command-line arguments. -->
  <!-- Generate an LCov report by default. LCov works well with the coverage-gutters VS Code extension.
    Override with e.g. -p:CoverletOutputFormat=cobertura -->
  <PropertyGroup>
    <CoverletOutputFormat Condition="'$(CoverletOutputFormat)' == ''">lcov</CoverletOutputFormat>
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --coverlet --coverlet-output-format $(CoverletOutputFormat) --coverlet-include "[LeaderElection*]*" --coverlet-exclude "[*.Tests]*" --coverlet-exclude-by-file "**/artifacts/**"</TestingPlatformCommandLineArguments>
  </PropertyGroup>
</Project>
